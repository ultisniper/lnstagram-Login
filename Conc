* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #fafafa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.demo-banner {
  width: 100%;
  background: #fff0d5;
  color: #814900;
  text-align: center;
  padding: 10px;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 1px;
}

.container {
  width: 350px;
  max-width: 92%;
  margin-top: 45px;
}

.login-box,
.signup-box {
  background: white;
  border: 1px solid #dbdbdb;
  padding: 35px 30px;
  text-align: center;
}

.logo {
  font-family: cursive;
  font-size: 42px;
  font-weight: bold;
  margin-bottom: 25px;
  letter-spacing: -2px;
}

.subtitle {
  color: #737373;
  font-size: 14px;
  margin-bottom: 20px;
}

input {
  width: 100%;
  padding: 12px 9px;
  margin-bottom: 7px;
  background: #fafafa;
  border: 1px solid #dbdbdb;
  border-radius: 3px;
  font-size: 12px;
  outline: none;
}

input:focus {
  border-color: #999;
}

form button {
  width: 100%;
  margin-top: 10px;
  padding: 10px;
  background: #4cb5f9;
  border: none;
  border-radius: 7px;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.or {
  display: flex;
  align-items: center;
  gap: 15px;
  color: #737373;
  font-size: 12px;
  font-weight: bold;
  margin: 25px 0;
}

.or span {
  flex: 1;
  height: 1px;
  background: #dbdbdb;
}

.facebook {
  display: block;
  color: #385185;
  text-decoration: none;
  font-weight: bold;
  font-size: 14px;
  margin-bottom: 20px;
}

.forgot {
  color: #00376b;
  text-decoration: none;
  font-size: 12px;
}

.signup-box {
  margin-top: 10px;
  padding: 22px;
  font-size: 14px;
}

.signup-box a {
  color: #0095f6;
  font-weight: bold;
  text-decoration: none;
}

.disclaimer {
  margin-top: 20px;
  text-align: center;
  color: #777;
  font-size: 11px;
  line-height: 1.6;
}

.warning {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.hidden {
  display: none;
}

.warning-card {
  background: white;
  border-radius: 12px;
  padding: 25px;
  max-width: 350px;
  text-align: center;
  line-height: 1.6;
}

.warning-card h2 {
  color: #d35400;
  margin-bottom: 15px;
}

.warning-card p {
  margin-bottom: 12px;
  font-size: 14px;
}

.warning-card button {
  background: #0095f6;
  border: none;
  color: white;
  padding: 10px 25px;
  border-radius: 6px;
  cursor: pointer;
}

@media (max-width: 400px) {
  .container {
    margin-top: 25px;
  }

  .login-box {
    padding: 30px 20px;
  }
}
